# Copy to server/.env (gitignored) for local runs; on Render set these in the dashboard.
# Never put any of these keys in the app.

# Required for AI answers. Without it /ask returns 503 and the app answers offline.
ANTHROPIC_API_KEY=
# Model and effort. Grounded Q&A over short passages works well at low effort (faster, cheaper).
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Password for the /admin upload page (uploads are disabled while empty). Use a long random string.
ADMIN_TOKEN=

# Optional: semantic search with Voyage AI embeddings (keyword search works without it).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Where uploads + the search index are stored (default: server/data). Use a persistent disk in production.
DATA_DIR=
# Optional comma-separated list of web origins allowed to call /ask (empty = any).
ALLOWED_ORIGINS=
MAX_UPLOAD_MB=20
PORT=8787
